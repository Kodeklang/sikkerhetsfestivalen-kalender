<!doctype html>
<html lang="no">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta name="theme-color" content="#e8850f">
<meta name="app-version" content="{{ site.version }}">
<meta name="base-path" content="{{ "/" | url }}">
<link rel="manifest" href="{{ "/manifest.webmanifest" | url }}">
<link rel="icon" href="{{ "/icons/icon.svg" | url }}" type="image/svg+xml">
<link rel="apple-touch-icon" href="{{ "/icons/icon-180.png" | url }}">
{#- The four faces every page uses. Without these the browser only discovers
    them after it has parsed fonts.css, which costs a round trip it does not
    need to spend. crossorigin is required even same-origin: font fetches are
    CORS-mode anonymous, and a preload without it is simply downloaded twice.
    IBM Plex Mono 600 is deliberately absent - only the detail pages use it. #}
{%- for f in ["montserrat-400", "montserrat-600", "montserrat-700", "ibm-plex-mono-400"] %}
<link rel="preload" href="{{ ("/css/fonts/" + f + "-latin.woff2") | url }}" as="font" type="font/woff2" crossorigin>
{%- endfor %}
<link rel="stylesheet" href="{{ "/css/fonts.css" | url }}">
<link rel="stylesheet" href="{{ "/css/style.css" | url }}">
<script defer src="{{ "/js/rum.js" | url }}"></script>
</head>
<body>
{{ content | safe }}

<p class="update" id="update" hidden>
  <span data-en="The programme has been updated.">Programmet er oppdatert.</span>
  <button type="button" id="update-reload" data-en="Reload">Last inn på nytt</button>
</p>

<script type="module" src="{{ "/js/app.js" | url }}"></script>
</body>
</html>
