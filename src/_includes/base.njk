<!doctype html>
<html lang="no">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta name="theme-color" content="#e8850f">
<meta name="app-version" content="{{ site.version }}">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/icons/icon-180.png">
<link rel="stylesheet" href="/css/fonts.css">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
{{ content | safe }}

<p class="update" id="update" hidden>
  <span data-en="The programme has been updated.">Programmet er oppdatert.</span>
  <button type="button" id="update-reload" data-en="Reload">Last inn på nytt</button>
</p>

<script type="module" src="/js/app.js"></script>
</body>
</html>
