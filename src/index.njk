---
permalink: /index.html
layout: base.njk
title: "Program · Sikkerhetsfestivalen 2026"
description: "Programmet for Sikkerhetsfestivalen 2026 i Lillehammer, 24.–26. august."
---
<div class="app app--landing">
  {% include "masthead.njk" %}
  <main class="landing">
    <h1>Sikkerhetsfestivalen 2026</h1>
    <p class="landing__dates">Lillehammer, 24.–26. august</p>
    <nav class="landing__days" aria-label="Velg dag">
      {%- for d in site.days %}
      <a class="landing__day" href="{{ d.url | url }}">
        <span class="landing__dow" data-en="{{ d.weekday.en }}">{{ d.weekday.no }}</span>
        <span class="landing__date">{{ d.dateLabel }}</span>
      </a>
      {%- endfor %}
    </nav>
  </main>
</div>
<script>
  // Jump straight to the day that is running, if any. Time-dependent, so it
  // must happen in the browser rather than at build time.
  (function () {
    var days = {{ site.daysIndex | dump | safe }};
    var today = new Date().toLocaleDateString("sv-SE", { timeZone: "Europe/Oslo" });
    var match = days.find(function (d) { return d.date === today; });
    if (match) location.replace({{ "/" | url | dump | safe }}.replace(/\/$/, "") + match.url);
  })();
</script>
